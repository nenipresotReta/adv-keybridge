#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/adv_screen.h>
/ {
    behaviors {
        page: page { compatible = "zmk,behavior-adv-page"; #binding-cells = <1>; };
        usb_host: usb_host { compatible = "zmk,behavior-usb-host"; #binding-cells = <0>; };
        screen: screen { compatible = "zmk,behavior-adv-screen"; #binding-cells = <1>; };
    };
    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH
                &mo 1 &kp LSHFT &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp RET
                &kp LCTRL &kp LGUI &kp LALT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp SPACE
            >;
        };
        function {
            bindings = <
                &kp ESC &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp DEL
                &trans &page 0 &page 1 &page 2 &page 3 &page 4 &trans &usb_host &screen ADV_SCREEN_OPEN &trans &trans &trans &trans &trans
                &trans &trans &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &trans &trans &trans &kp HOME &kp PG_UP &trans &kp UP &trans &trans
                &trans &trans &trans &kp C_PREV &kp C_NEXT &kp C_PLAY_PAUSE &trans &trans &kp END &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &trans
            >;
        };
        settings {
            /* Every key is local or blocked. No transparent Bluetooth/USB bindings. */
            bindings = <
                &screen ADV_SCREEN_BACK &none &none &none &none &none &none &none &none &none &none &none &none &screen ADV_SCREEN_BACK
                &none &none &screen ADV_SCREEN_PREVIOUS &none &none &none &none &none &screen ADV_SCREEN_BACK &none &none &none &none &none
                &none &none &screen ADV_SCREEN_DIM &screen ADV_SCREEN_NEXT &screen ADV_SCREEN_BRIGHTEN &none &none &none &none &none &none &screen ADV_SCREEN_PREVIOUS &none &screen ADV_SCREEN_SELECT
                &none &none &none &none &none &none &none &none &none &none &screen ADV_SCREEN_DIM &screen ADV_SCREEN_NEXT &screen ADV_SCREEN_BRIGHTEN &none
            >;
        };
    };
};
